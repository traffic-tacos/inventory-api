# Server Configuration
GRPC_PORT=8080
LOG_LEVEL=info

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_PROFILE=tacos

# DynamoDB Tables
DDB_TABLE_INVENTORY=inventory
DDB_TABLE_SEATS=inventory_seats
DDB_TABLE_IDEMPOTENCY=idempotency

# Idempotency Settings
IDEMPOTENCY_TTL_SECONDS=300

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=inventory-api
OTEL_SERVICE_VERSION=1.0.0

# Performance Settings
MAX_CONCURRENT_STREAMS=1000
SERVER_TIMEOUT_MS=250
IDEMPOTENCY_CACHE_TTL_SECONDS=300

# Inventory Configuration
INVENTORY_MODE=quantity
USE_OPTIMISTIC_LOCKING=true